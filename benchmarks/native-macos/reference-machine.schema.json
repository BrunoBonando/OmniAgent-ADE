{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OmniAgent native macOS benchmark reference machine",
  "type": "object",
  "required": ["schema_version", "collected_at", "macos_version", "hardware_model", "chip", "cpu_cores", "memory_bytes"],
  "properties": {
    "schema_version": { "const": 1 },
    "collected_at": { "type": "string", "format": "date-time" },
    "macos_version": { "type": "string" },
    "hardware_model": { "type": ["string", "null"] },
    "chip": { "type": ["string", "null"] },
    "cpu_cores": { "type": ["integer", "null"], "minimum": 1 },
    "memory_bytes": { "type": ["integer", "null"], "minimum": 1 }
  },
  "additionalProperties": false
}
